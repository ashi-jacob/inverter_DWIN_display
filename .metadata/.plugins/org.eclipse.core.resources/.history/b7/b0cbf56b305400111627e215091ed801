#include "hal_data.h"
#include "graph.h"

uint8_t command[] =
{ 0x5A, 0xA5,  // Frame header
  0x0D,        // Data length (13 bytes follow)
  0x82,        // Write instruction
  0x03,
  0x10,  // Curve fixed address
  0x5A,
  0xA5,  // Curve Buffer Init command
  0x01,
  0x00,  // 1 channel active
  0x00,
  0x02,  // Target Channel 0, sending 2 words (points) at a time

  // Data payload slots
  0x00,
  0x28,  // command[12], command[13] -> Point 1 Y-Value
  0x00,
  0x28   // command[14], command[15] -> Point 2 Y-Value
        };

static uint8_t num;

void dwin_display_graph()
{

    num++;
    // 3. Clear callback check flag and fire the data frame out

    if (num % 3 == 0)
    {
        command[15] = 0x15;
    }
    else
    {
        command[15] = 0x28;
    }

    R_SCI_UART_Write (&g_uart4_ctrl, command, sizeof(command));

    // Wait here transparently for the hardware UART shift registers to empty safely
    // This ensures frames never stomp on top of each other

    // Control scrolling speed / step width across your layout grid
    R_BSP_SoftwareDelay (1000, BSP_DELAY_UNITS_MILLISECONDS);
}

