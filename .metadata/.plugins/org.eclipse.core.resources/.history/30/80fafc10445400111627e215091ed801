#include "hal_data.h"
#include "graph.h"

// GRID 1: Output Voltage (Curve ID 0 -> Address 0x0310)
uint8_t output_voltage_command[] =
{
  0x5A, 0xA5,  // Frame header
  0x0D,        // Data length (13 bytes follow)
  0x82,        // Write instruction
  0x03, 0x10,  // Curve 0 fixed address
  0x5A, 0xA5,  // Curve Buffer Init command
  0x00,        // 1 channel active
  0x00,        // Target Channel 0 for this grid
  0x00, 0x02,  // Sending 2 words (points) at a time

  // Data payload slots
  0x00, 0x28,  // command[12], command[13] -> Point 1 Y-Value
  0x00, 0x28   // command[14], command[15] -> Point 2 Y-Value
};

// GRID 2: Input Voltage (Curve ID 1 -> Address 0x0320)
uint8_t input_voltage_command[] =
{
  0x5A, 0xA5,  // Frame header
  0x0D,        // Data length (13 bytes follow)
  0x82,        // Write instruction
  0x03, 0x20,  // Curve 1 fixed address
  0x5A, 0xA5,  // Curve Buffer Init command
  0x00,        // 1 channel active
  0x00,        // Target Channel 0 for this grid
  0x00, 0x02,  // Sending 2 words (points) at a time

  // Data payload slots
  0x00, 0x18,  // command[12], command[13] -> Point 1 Y-Value
  0x00, 0x18   // command[14], command[15] -> Point 2 Y-Value
};

// GRID 3: Load Percentage (Curve ID 2 -> Address 0x0330)
uint8_t load_percent_command[] =
{
  0x5A, 0xA5,  // Frame header
  0x0D,        // Data length (13 bytes follow)
  0x82,        // Write instruction
  0x03, 0x30,  // Curve 2 fixed address
  0x5A, 0xA5,  // Curve Buffer Init command
  0x00,        // 1 channel active
  0x00,        // Target Channel 0 for this grid
  0x00, 0x02,  // Sending 2 words (points) at a time

  // Data payload slots
  0x00, 0x0A,  // command[12], command[13] -> Point 1 Y-Value
  0x00, 0x0A   // command[14], command[15] -> Point 2 Y-Value
};

static uint8_t num1;
static uint8_t num2;
static uint8_t num3;

void dwin_display_output_voltage_graph()
{
    // STEP 1: Shift history point 2 into point 1
    output_voltage_command[12] = output_voltage_command[14];
    output_voltage_command[13] = output_voltage_command[15];

    num1++;
    output_voltage_command[14] = 0x00; // Always clear high byte for 8-bit numbers

    if (num1 % 3 == 0)
    {
        output_voltage_command[15] = 0x15;
    }
    else
    {
        output_voltage_command[15] = 0x28;
    }


    R_SCI_UART_Write (&g_uart4_ctrl, output_voltage_command, sizeof(output_voltage_command));


    // Tiny safety delay so serial buffers can clear, NOT 1000ms
    R_BSP_SoftwareDelay (500, BSP_DELAY_UNITS_MILLISECONDS);
}

void dwin_display_input_voltage_graph()
{
    // STEP 1: Shift history point 2 into point 1
    input_voltage_command[12] = input_voltage_command[14];
    input_voltage_command[13] = input_voltage_command[15];

    num2++;
    input_voltage_command[14] = 0x00; // Always clear high byte

    if (num2 % 3 == 0)
    {
        input_voltage_command[15] = 0x21;
    }
    else
    {
        input_voltage_command[15] = 0x18;
    }


    R_SCI_UART_Write (&g_uart4_ctrl, input_voltage_command, sizeof(input_voltage_command));


    R_BSP_SoftwareDelay (500, BSP_DELAY_UNITS_MILLISECONDS);
}

void dwin_display_load_percent_graph()
{
    // STEP 1: Shift history point 2 into point 1
    load_percent_command[12] = load_percent_command[14];
    load_percent_command[13] = load_percent_command[15];

    num3++;
    load_percent_command[14] = 0x00; // Always clear high byte

    if (num3 % 19 == 0)
    {
        load_percent_command[15] = 0x32; // Fixed decimal representation literal typo
    }
    else if (num3 % 47 == 0)
    {
        load_percent_command[15] = 0x0A;
    }
    else
    {
        load_percent_command[15] = 0x0A; // Fallback so points continue moving
    }


    R_SCI_UART_Write (&g_uart4_ctrl, load_percent_command, sizeof(load_percent_command));

    R_BSP_SoftwareDelay (500, BSP_DELAY_UNITS_MILLISECONDS);
}
