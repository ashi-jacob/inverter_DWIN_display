#include "hal_data.h"
#include "value.h"



uint8_t dwin_cmd_input_voltage[] =
    {
        0x5A,
        0xA5,
        0x05,
        0x82,
        0x10,
        0x00,
        0x00,
        0x30
    };

uint8_t dwin_cmd_output_voltage[] =
    {
        0x5A,
        0xA5,
        0x05,
        0x82,
        0x10,
        0x10,
        0x00,
        0x0C
    };

uint8_t dwin_cmd_load_percentage[] =
     {
         0x5A,
         0xA5,
         0x05,
         0x82,
         0x10,
         0x20,
         0x00,
         0x0A
     };


uint8_t dwin_batt_percentage[] =
     {
         0x5A,
         0xA5,
         0x05,
         0x82,
         0x20,
         0x50,
         0x00,
         0x32
     };
void dwin_display_input_voltage()
{

           /* Send DWIN frame */
           R_SCI_UART_Write(&g_uart4_ctrl,
                   dwin_cmd_input_voltage,
                            sizeof(dwin_cmd_input_voltage));

           R_BSP_SoftwareDelay(500, BSP_DELAY_UNITS_MILLISECONDS);


}

void dwin_display_output_voltage()
{
    R_SCI_UART_Write(&g_uart4_ctrl,
                            dwin_cmd_output_voltage,
                                     sizeof(dwin_cmd_output_voltage));

    R_BSP_SoftwareDelay(500, BSP_DELAY_UNITS_MILLISECONDS);

}

void dwin_display_load_percentage_value()
{
               R_SCI_UART_Write(&g_uart4_ctrl,
                       dwin_cmd_load_percentage,
                                      sizeof(dwin_cmd_load_percentage));

               R_BSP_SoftwareDelay(500, BSP_DELAY_UNITS_MILLISECONDS);

}

void dwin_display_batt_percentage_value()
{

    R_SCI_UART_Write(&g_uart4_ctrl,
                     dwin_batt_percentage,
                           sizeof(dwin_batt_percentage));
    R_BSP_SoftwareDelay(100, BSP_DELAY_UNITS_MILLISECONDS);

}
