#include "hal_data.h"


uint8_t dwin_cmd_input_voltage[] =
    {
        0x5A,
        0xA5,
        0x05,
        0x82,
        0x10,
        0x00,
        0x00,
        0xE6
    };

uint8_t dwin_cmd_output_voltage[] =
    {
        0x5A,
        0xA5,
        0x05,
        0x82,
        0x10,
        0x10,
        0x00,
        0xE4
    };

uint8_t dwin_cmd_load_percentage[] =
     {
         0x5A,
         0xA5,
         0x05,
         0x82,
         0x10,
         0x20,
         0x00,
         0x28
     };
static void dwin_display_values()
{
    /* Reset TX flag */
           uart_tx_complete = false;

           /* Send DWIN frame */
           R_SCI_UART_Write(&g_uart4_ctrl,
                   dwin_cmd_input_voltage,
                            sizeof(dwin_cmd_input_voltage));
           while (!uart_tx_complete);

           uart_tx_complete = false;
           R_SCI_UART_Write(&g_uart4_ctrl,
                         dwin_cmd_output_voltage,
                                  sizeof(dwin_cmd_output_voltage));
           while (!uart_tx_complete);

           uart_tx_complete = false;
           R_SCI_UART_Write(&g_uart4_ctrl,
                   dwin_cmd_load_percentage,
                                  sizeof(dwin_cmd_load_percentage));
           /* Wait for transmission complete */
           while (!uart_tx_complete);

           /* Delay between transmissions */
           R_BSP_SoftwareDelay(1000,
                               BSP_DELAY_UNITS_MILLISECONDS);



}
