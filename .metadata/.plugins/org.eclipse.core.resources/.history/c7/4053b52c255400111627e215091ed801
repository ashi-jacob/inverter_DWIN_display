static void dwin_display_input_voltage()
{

           /* Send DWIN frame */
           R_SCI_UART_Write(&g_uart4_ctrl,
                   dwin_cmd_input_voltage,
                            sizeof(dwin_cmd_input_voltage));




}

static void dwin_display_output_voltage()
{
    R_SCI_UART_Write(&g_uart4_ctrl,
                            dwin_cmd_output_voltage,
                                     sizeof(dwin_cmd_output_voltage));

}

static void dwin_display_load_percentage_value()
{

               R_SCI_UART_Write(&g_uart4_ctrl,
                       dwin_cmd_load_percentage,
                                      sizeof(dwin_cmd_load_percentage));

}
