//    };
//
//    uint8_t dwin_cmd_load_percentage[] =
//     {
//         0x5A,
//         0xA5,
//         0x05,
//         0x82,
//         0x10,
//         0x02,
//         0x00,
//         0x28
//     };

    /* Open UART */
    R_SCI_UART_Open(&g_uart4_ctrl, &g_uart4_cfg);

    /* Startup delay */
    R_BSP_SoftwareDelay(100, BSP_DELAY_UNITS_MILLISECONDS);

    uint8_t curve_cmd[] =
    {
        0x5A, 0xA5, // Header
        0x06,       // Length: 0x84(1) + Channel(1) + VP(2) + Data(2) = 6 bytes
        0x84,       // Command: Write Curve
        0x00,       // Curve Channel (Usually 0 for the first curve)
        0x10, 0x00, // VP Address (Matches your DGUS setting, e.g., 1000)
        0x00, 0x64  // Data (0x64 = 100 decimal)
    };
    uint16_t curve_value = 100; // Start at 100


    while(1)
    {
        // Update the data bytes in the array (Big Endian)
        curve_cmd[6] = (uint8_t)(curve_value >> 8);   // High byte
        curve_cmd[7] = (uint8_t)(curve_value & 0xFF); // Low byte

        uart_tx_complete = false;
        R_SCI_UART_Write(&g_uart4_ctrl, curve_cmd, sizeof(curve_cmd));
        while(!uart_tx_complete);

        // Decrease the value
        if (curve_value > 0) {
            curve_value--;
        } else {
            curve_value = 100; // Reset to 100 when it hits 0
        }

        R_BSP_SoftwareDelay(100, BSP_DELAY_UNITS_MILLISECONDS); // Faster update for smooth curve
    }
#if BSP_TZ_SECURE_BUILD
    R_BSP_NonSecureEnter();
#endif
}


/*******************************************************************************************************************//**
 * This function is called at various points during the startup process.  This implementation uses the event that is
 * called right before main() to set up the pins.
 *
 * @param[in]  event    Where at in the start up process the code is currently at
 **********************************************************************************************************************/
void R_BSP_WarmStart(bsp_warm_start_event_t event)
{
    if (BSP_WARM_START_RESET == event)
    {
#if BSP_FEATURE_FLASH_LP_VERSION != 0

        /* Enable reading from data flash. */
        R_FACI_LP->DFLCTL = 1U;

        /* Would normally have to wait tDSTOP(6us) for data flash recovery. Placing the enable here, before clock and
         * C runtime initialization, should negate the need for a delay since the initialization will typically take more than 6us. */
#endif
    }

    if (BSP_WARM_START_POST_C == event)
    {
        /* C runtime environment and system clocks are setup. */

        /* Configure pins. */
        R_IOPORT_Open (&g_ioport_ctrl, g_ioport.p_cfg);
    }
}

